# Comparables.ai — environment template
# Copy to .env and fill in.
#
# Env keys use `env_nested_delimiter="__"`, so `API__HOST=0.0.0.0` maps to
# `settings.api.host`. Older flat keys (APP_HOST, etc.) are NOT honoured.

# ─── App (settings.api.*) ──────────────────────────────────────────
API__ENV=dev
API__HOST=0.0.0.0
API__PORT=8000
API__RELOAD=false
API__LOG_LEVEL=INFO
API__LOG_JSON=true

# ─── Paths (settings.paths.*) ──────────────────────────────────────
PATHS__COMPANIES_JSON=./companies.json
PATHS__SQLITE=./data/companies.sqlite
PATHS__BM25_PICKLE=./data/bm25.pkl
PATHS__RUNS_DIR=./runs

# ─── LLM (settings.llm.*) ──────────────────────────────────────────
# Available locally; pick one that fits your hardware:
#   ministral-3:3b    (3.0 GB) — RECOMMENDED: clean structured output, no thinking mode
#   qwen3.5:2b        (2.7 GB) — smaller but uses thinking mode (extra tokens)
#   qwen3.5:0.8b      (1.0 GB) — fastest, weaker JSON compliance
#   deepseek-r1:1.5b  (1.1 GB) — strong reasoning, but emits CoT
#   deepseek-r1:7b    (4.7 GB) — strongest, slowest
LLM__BASE_URL=http://localhost:11434/v1
LLM__API_KEY=ollama
LLM__MODEL=ministral-3:3b
LLM__TIMEOUT_S=120

# ─── Workflow limits (settings.limits.*) — per assessment brief ────
LIMITS__TIMEOUT_S=120
LIMITS__MAX_RETRIEVAL_ITERATIONS=2
LIMITS__MAX_REVISED_SEARCHES=1
LIMITS__MAX_CANDIDATES_PER_ITER=100
LIMITS__MAX_CANDIDATES_TO_VALIDATE=10
LIMITS__MAX_FINAL_RESULTS=10
LIMITS__MAX_LLM_CALLS_PER_RUN=5

# ─── Scoring weights (settings.scoring.*) ──────────────────────────
SCORING__W_BM25=0.7
SCORING__W_FILTERS=0.3
