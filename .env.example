# Comparables.ai — environment template
# Copy to .env and fill in.

# ─── App ─────────────────────────────────────────────────────────────
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOG_JSON=true

# ─── Paths ───────────────────────────────────────────────────────────
COMPANIES_JSON_PATH=./companies.json
SQLITE_PATH=./data/companies.sqlite
BM25_PICKLE_PATH=./data/bm25.pkl
RUNS_DIR=./runs

# ─── Ollama (OpenAI-compat) ─────────────────────────────────────────
# Available locally; pick one that fits your hardware:
#   ministral-3:3b    (3.0 GB) — RECOMMENDED: clean structured output, no thinking mode
#   qwen3.5:2b        (2.7 GB) — smaller but uses thinking mode (extra tokens)
#   qwen3.5:0.8b      (1.0 GB) — fastest, weaker JSON compliance
#   deepseek-r1:1.5b  (1.1 GB) — strong reasoning, but emits CoT
#   deepseek-r1:7b    (4.7 GB) — strongest, slowest
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=ministral-3:3b
OLLAMA_TIMEOUT_S=120

# ─── Workflow limits (per assessment) ────────────────────────────────
WORKFLOW_TIMEOUT_S=60
MAX_RETRIEVAL_ITERATIONS=2
MAX_REVISED_SEARCHES=1
MAX_CANDIDATES_PER_ITER=100
MAX_CANDIDATES_TO_VALIDATE=10
MAX_FINAL_RESULTS=10
MAX_LLM_CALLS_PER_RUN=5

# ─── Retrieval scoring ───────────────────────────────────────────────
SCORE_W_BM25=0.7
SCORE_W_FILTERS=0.3
